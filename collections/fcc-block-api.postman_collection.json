    {
      "id": "fd02a9e1-5087-41ae-923a-3938b1fb3d9a",
      "name": "block",
      "description": {
        "content": "Get census block, county, and state FIPS codes by latitude and longitude",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e5a5b51b-866a-41b8-ae0f-990291b430f3",
          "name": "Get Census Block FIPS by Latitude and Longitude",
          "request": {
            "name": "Get Census Block FIPS by Latitude and Longitude",
            "description": {
              "content": "Returns the US Census Bureau Census Block FIPS code, county FIPS code, and state FIPS code for a given latitude and longitude. Also returns the associated US State and County names.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "block",
                "find"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "latitude",
                  "value": "<string>",
                  "description": "(Required) Latitude in decimal degrees or DMS format. Range: -90 to 90. Examples: 38.26 or 38:15:36N\n"
                },
                {
                  "disabled": false,
                  "key": "longitude",
                  "value": "<string>",
                  "description": "(Required) Longitude in decimal degrees or DMS format. Range: -180 to 180. Examples: -77.51 or 77:30:36W\n"
                },
                {
                  "disabled": false,
                  "key": "censusYear",
                  "value": "2020",
                  "description": "Census year for results. Valid values: 2010, 2020 (default)"
                },
                {
                  "disabled": false,
                  "key": "showall",
                  "value": "false",
                  "description": "If the coordinate lies on the boundary of multiple geographies, use showall=true to return the complete list.\n"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "xml",
                  "description": "Response format. Defaults to xml."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "b7630249-3d21-45b1-96ff-343b50c2e7d3",
              "name": "Census block, county, and state data for the specified location",
              "originalRequest": {
                "url": {
                  "path": [
                    "block",
                    "find"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "latitude",
                      "value": "<string>"
                    },
                    {
                      "key": "longitude",
                      "value": "<string>"
                    },
                    {
                      "key": "censusYear",
                      "value": "2020"
                    },
                    {
                      "key": "showall",
                      "value": "false"
                    },
                    {
                      "key": "format",
                      "value": "xml"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"Block\": {\n    \"FIPS\": \"110010083011001\",\n    \"bbox\": [\n      4027.6113005007664,\n      6743.637958065118\n    ]\n  },\n  \"County\": {\n    \"FIPS\": \"11001\",\n    \"name\": \"District of Columbia\"\n  },\n  \"State\": {\n    \"FIPS\": \"11\",\n    \"code\": \"DC\",\n    \"name\": \"District of Columbia\"\n  },\n  \"status\": \"OK\",\n  \"executionTime\": \"0\"\n}",
