          "name": "Get Terrain Elevation Profile",
          "request": {
            "name": "Get Terrain Elevation Profile",
            "description": {
              "content": "Get the terrain elevation profile along a path between two geographic points, specified by a starting point plus azimuth, or start and end coordinates.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "profile.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "(Required) Latitude of the starting point in decimal degrees"
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<double>",
                  "description": "(Required) Longitude of the starting point in decimal degrees"
                },
                {
                  "disabled": false,
                  "key": "azimuth",
